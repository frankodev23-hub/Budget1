    private async Task DeleteHold(int holdId)
    {
        using var context = DbFactory.CreateDbContext();

        var hold = await context.Holds.FindAsync(holdId);

        if (hold == null)
            return;

        // Eliminar el hold
        context.Holds.Remove(hold);

        // Actualizar transacciones relacionadas
        await context.Transactions
            .Where(t => t.IsUnexpected &&
                        t.Date.Month == hold.MonthHold.Month &&
                        t.Date.Year == hold.MonthHold.Year)
            .ExecuteUpdateAsync(setters =>
                setters.SetProperty(p => p.IsUnexpected, false)
            );

        // Guardar cambios (incluye el Remove)
        await context.SaveChangesAsync();

        // UI
        message = "Hold";
        showSuccessModal = true;

        await LoadData(); // Debe usar OTRO DbContext
        await LoadTransactionsList(hold.MonthHold.Year);
    }

