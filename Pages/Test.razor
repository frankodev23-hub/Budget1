    private async Task SaveNote()
    {
        if (!_editorInitialized || MyEditor is null)
            return;

        try
        {
            // Obtener contenido HTML del editor (incluye imágenes)
            var htmlContent = await MyEditor.GetHTML();

            // Buscar la nota existente
            var note = await DbContext.Notes.FirstOrDefaultAsync();

            if (note != null)
            {
                // Actualizar contenido y fecha de actualización
                note.Content = htmlContent;
                note.UpdatedAt = DateTime.Now;
                DbContext.Notes.Update(note);
            }
            else
            {
                // Crear nota por primera vez
                note = new Note
                    {
                        Content = htmlContent,
                        CreatedAt = DateTime.Now
                    };
                DbContext.Notes.Add(note);
            }
            await DbContext.SaveChangesAsync();
            ShowMessageSucccess(ToastType.Success);
        }
        catch (Exception ex)
        {
            ShowMessageDanger(ToastType.Danger);
            Console.WriteLine("Error guardando nota: " + ex.Message);
        }
    }



