    private async Task LoadTransactions(DateTime? startMonth, DateTime? endMonth)
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            var query = DbContext.Transactions
                .Include(t => t.Category)
                .Include(t => t.Wallet)
                .AsQueryable();

            if (selectedWalletId.HasValue)
                query = query.Where(t => t.WalletId == selectedWalletId.Value);

            DateTime globalStartDate = new DateTime(startMonth!.Value.Year, startMonth.Value.Month, 1);
            DateTime globalEndDate = new DateTime(endMonth!.Value.Year, endMonth.Value.Month, 1).AddMonths(1).AddDays(-1);

            query = query.Where(t => t.Date <= globalEndDate);

            var allTransactions = await query.OrderBy(t => t.Date).ToListAsync();

            // ❌ Quitamos el Clear()
            // groupedTransactions.Clear();
            // cumulativeBalances.Clear();

            var prevBalance = await DbContext.PreviousBalances
                .Where(pb => pb.WalletId == selectedWallet.Id && pb.Month < globalStartDate)
                .OrderByDescending(pb => pb.Month)
                .FirstOrDefaultAsync();

            decimal previousBalance = prevBalance?.Balance ?? selectedWallet.InitialBalance;

            for (var date = globalStartDate; date <= globalEndDate; date = date.AddMonths(1))
            {
                var monthStart = new DateTime(date.Year, date.Month, 1);
                var monthEnd = monthStart.AddMonths(1).AddDays(-1);

                var monthTxs = allTransactions
                    .Where(t => t.Date >= monthStart && t.Date <= monthEnd)
                    .ToList();

                var currentMonthBalance = monthTxs.Sum(t => t.IsIncome ? t.Amount : -t.Amount);
                previousBalance += currentMonthBalance;

                if (monthTxs.Any() || previousBalance != 0)
                {
                    // ✅ En vez de reemplazar todo, insertamos/actualizamos mes por mes
                    groupedTransactions[(selectedWallet, monthStart)] = monthTxs;
                    cumulativeBalances[(selectedWallet.Id, monthStart)] = previousBalance;
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }


