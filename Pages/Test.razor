    private async Task SaveTransaction()
    {
        if (selectedWallet == null)
            return;

        // Validación: Categoría válida
        var validCategory = categories.Any(c => c.Id == transactionForm.CategoryId);
        if (!validCategory)
        {
            transactionValidationError = "Please select a valid category.";
            StateHasChanged();
            return;
        }

        // Validaciones de recurrencia
        if (transactionForm.IsRecurring)
        {
            if (!transactionForm.RecurrenceIntervalId.HasValue)
            {
                transactionValidationError = "Please select a recurrence interval.";
                StateHasChanged();
                return;
            }

            if (!transactionForm.RecurrenceEndType.HasValue)
            {
                transactionValidationError = "Please select a recurrence end type.";
                StateHasChanged();
                return;
            }

            switch (transactionForm.RecurrenceEndType)
            {
                case RecurrenceEndType.EndDate:
                    if (!transactionForm.RecurrenceEndDate.HasValue)
                    {
                        transactionValidationError = "Please select an end date.";
                        StateHasChanged();
                        return;
                    }
                    break;

                case RecurrenceEndType.NumberOfOccurrences:
                    if (!transactionForm.RecurrenceCount.HasValue || transactionForm.RecurrenceCount <= 1)
                    {
                        transactionValidationError = "Please enter a valid number of repetitions (minimum 2).";
                        StateHasChanged();
                        return;
                    }
                    break;

                case RecurrenceEndType.UntilFurtherNotice:
                    break;
            }
        }

        // Establece fechas con DateTimeKind
        transactionForm.Date = DateTime.SpecifyKind(transactionForm.Date, DateTimeKind.Utc);
        if (transactionForm.RecurrenceEndDate.HasValue)
            transactionForm.RecurrenceEndDate = DateTime.SpecifyKind(transactionForm.RecurrenceEndDate.Value, DateTimeKind.Utc);

        // Determina si es Income según la categoría
        var selectedCategory = categories.FirstOrDefault(c => c.Id == transactionForm.CategoryId);
        transactionForm.IsIncome = selectedCategory?.Type == "Income";

        // Verifica si la transacción original es unexpected
        transactionForm.IsUnexpected = await DbContext.Holds.AnyAsync(h =>
            h.WalletId == transactionForm.WalletId &&
            h.MonthHold.Year == transactionForm.Date.Year &&
            h.MonthHold.Month == transactionForm.Date.Month);

        if (currentAction == ActionType.Edit && userChoice == RecurrenceActionChoice.ThisAndFuture && transactionToEditOrDelete != null)
        {
            // Editar esta y futuras transacciones recurrentes

            // Primero, actualiza la transacción original (en caso que sea modificada)
            var originalId = transactionToEditOrDelete.OriginalTransactionId ?? transactionToEditOrDelete.Id;
            var originalTransaction = await DbContext.Transactions.FindAsync(originalId);
            if (originalTransaction != null)
            {
                // Ajustar balance para la original
                var walletOrig = await DbContext.Wallets.FindAsync(originalTransaction.WalletId);
                if (walletOrig != null)
                {
                    if (originalTransaction.IsIncome)
                        walletOrig.Balance -= originalTransaction.Amount;
                    else
                        walletOrig.Balance += originalTransaction.Amount;

                    if (transactionForm.IsIncome)
                        walletOrig.Balance += transactionForm.Amount;
                    else
                        walletOrig.Balance -= transactionForm.Amount;
                }

                if (originalId == transactionToEditOrDelete.Id)
                {
                    // Actualiza campos originales
                    originalTransaction.Name = transactionForm.Name;
                    originalTransaction.Description = transactionForm.Description;
                    originalTransaction.Date = transactionForm.Date;
                    originalTransaction.Amount = transactionForm.Amount;
                    originalTransaction.WalletId = transactionForm.WalletId;
                    originalTransaction.CategoryId = transactionForm.CategoryId;
                    originalTransaction.IsIncome = transactionForm.IsIncome;
                    if (transactionForm.Tithe)
                    {
                        AddTithe(transactionForm, false);
                    }
                    originalTransaction.Tithe = transactionForm.Tithe;

                    await DbContext.SaveChangesAsync();
                }


            }


            // Luego actualiza las transacciones futuras
            DateTime targetDate = transactionToEditOrDelete.Date;
            var transactionsToUpdate = await DbContext.Transactions
                .Where(tr =>
                    (tr.OriginalTransactionId == originalId || tr.Id == originalId) &&
                    tr.Date >= targetDate &&
                    tr.Id != originalId) // excluye la original porque ya la actualizamos
                .ToListAsync();

            foreach (var tr in transactionsToUpdate)
            {
                var wallet = await DbContext.Wallets.FindAsync(tr.WalletId);
                if (wallet != null)
                {
                    // Revertir monto antiguo
                    if (tr.IsIncome)
                        wallet.Balance -= tr.Amount;
                    else
                        wallet.Balance += tr.Amount;

                    // Aplicar nuevo monto
                    if (transactionForm.IsIncome)
                        wallet.Balance += transactionForm.Amount;
                    else
                        wallet.Balance -= transactionForm.Amount;
                }

                // Actualiza datos
                tr.Name = transactionForm.Name;
                tr.Description = transactionForm.Description;
                tr.Amount = transactionForm.Amount;
                tr.WalletId = transactionForm.WalletId;
                tr.CategoryId = transactionForm.CategoryId;
                tr.IsIncome = transactionForm.IsIncome;
                tr.IsUnexpected = transactionForm.IsUnexpected;
                if (transactionForm.Tithe)
                {
                    AddTithe(tr, false);
                }
                tr.Tithe = transactionForm.Tithe;

                // No modificar IsRecurring ni OriginalTransactionId aquí para no romper FK
            }

            await DbContext.SaveChangesAsync();
        }
        else
        {
            // Crear o editar una sola transacción
            if (transactionForm.Id == 0)
            {
                // Nueva transacción

                // Primero guarda la transacción original para obtener Id
                DbContext.Transactions.Add(transactionForm);

                // Guardamos primero para generar el Id
                await DbContext.SaveChangesAsync();

                if (transactionForm.Tithe)
                {
                    AddTithe(transactionForm, false);
                }

                //Aqui es el error
                await DbContext.SaveChangesAsync();

                // Si es recurrente, crea transacciones recurrentes usando el Id ya generado
                if (transactionForm.IsRecurring)
                {
                    var interval = await DbContext.RecurrenceIntervals.FindAsync(transactionForm.RecurrenceIntervalId.Value);

                    if (interval != null)
                    {
                        DateTime nextDate = transactionForm.Date;

                        switch (transactionForm.RecurrenceEndType)
                        {
                            case RecurrenceEndType.EndDate:
                                {
                                    DateTime endDate = transactionForm.RecurrenceEndDate!.Value;
                                    while (true)
                                    {
                                        nextDate = CalculateNextDate(nextDate, interval);
                                        if (nextDate > endDate) break;
                                        await AddRecurringTransaction(nextDate, interval, transactionForm);
                                    }
                                    break;
                                }

                            case RecurrenceEndType.NumberOfOccurrences:
                                {
                                    int repetitions = transactionForm.RecurrenceCount!.Value;
                                    for (int i = 1; i < repetitions; i++)
                                    {
                                        nextDate = CalculateNextDate(nextDate, interval);
                                        await AddRecurringTransaction(nextDate, interval, transactionForm);
                                    }
                                    break;
                                }

                            case RecurrenceEndType.UntilFurtherNotice:
                                {
                                    DateTime maxDate = nextDate.AddMonths(36);
                                    while (true)
                                    {
                                        nextDate = CalculateNextDate(nextDate, interval);
                                        if (nextDate > maxDate) break;
                                        await AddRecurringTransaction(nextDate, interval, transactionForm);
                                    }
                                    break;
                                }
                        }

                        await DbContext.SaveChangesAsync();
                    }
                }
            }
            else
            {
                // Editar transacción existente simple
                var existingTransaction = await DbContext.Transactions.FindAsync(transactionForm.Id);
                if (existingTransaction != null)
                {
                    var wallet = await DbContext.Wallets.FindAsync(existingTransaction.WalletId);
                    if (wallet != null)
                    {
                        if (existingTransaction.IsIncome)
                            wallet.Balance -= existingTransaction.Amount;
                        else
                            wallet.Balance += existingTransaction.Amount;

                        if (transactionForm.IsIncome)
                            wallet.Balance += transactionForm.Amount;
                        else
                            wallet.Balance -= transactionForm.Amount;
                    }

                    existingTransaction.Name = transactionForm.Name;
                    existingTransaction.Description = transactionForm.Description;
                    existingTransaction.Date = transactionForm.Date;

                    existingTransaction.WalletId = transactionForm.WalletId;
                    existingTransaction.CategoryId = transactionForm.CategoryId;
                    existingTransaction.IsIncome = transactionForm.IsIncome;
                    if (existingTransaction.Amount != transactionForm.Amount)
                    {
                        existingTransaction.IsUnexpected = true;
                    }
                    existingTransaction.Amount = transactionForm.Amount;
                    existingTransaction.IsRecurring = transactionForm.IsRecurring;
                    if (existingTransaction.Tithe != transactionForm.Tithe)
                    {
                        if (transactionForm.Tithe)
                        {
                            AddTithe(transactionForm, false);
                        }
                        else
                        {
                            //Si desmarca el tithe, entonces eliminamos las transacciones de Tithe
                            await DeleteTitheAsync(existingTransaction.Id);
                        }

                    }
                    existingTransaction.Tithe = transactionForm.Tithe;


                    existingTransaction.RecurrenceIntervalId = transactionForm.RecurrenceIntervalId;
                    existingTransaction.RecurrenceEndType = transactionForm.RecurrenceEndType;
                    existingTransaction.RecurrenceCount = transactionForm.RecurrenceCount;
                    existingTransaction.RecurrenceEndDate = transactionForm.RecurrenceEndDate;
                    existingTransaction.OriginalTransactionId = transactionForm.OriginalTransactionId;

                    await DbContext.SaveChangesAsync();
                }
            }
        }

        CloseModalTransaction();
        await LoadData();
        currentAction = ActionType.None;



        var date = new DateTime(transactionForm.Date.Year, transactionForm.Date.Month, 1);

        await LoadTransactions(date, date);
    }

