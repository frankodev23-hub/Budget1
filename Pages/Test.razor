<!-- Modal de conformación para eliminar transacción-->
@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Deletion</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure to delete the following transactions?</p>

                    <ul>
                        @foreach (var tx in transactionsToDelete)
                        {
                            <li>@tx.Date.ToString("yyyy-MM-dd") - @tx.Description (@FormatAmount(@tx.Amount, selectedWallet.Currency))</li>
