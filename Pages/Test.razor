    {
        if (string.IsNullOrWhiteSpace(NewTransactionName) || NewTransactionAmount <= 0)
            return;

        var forecast = new BudgetForecast
            {
                WalletId = selectedWallet.Id,
                Year = year,
                Month = DateTime.Now.Month,
                TransactionName = NewTransactionName.Trim(),
