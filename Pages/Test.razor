                                                    }

                                                    var cardStyle = "width: 300px; min-height: 300px; max-height: 400px; overflow: hidden; display: flex; flex-direction: column;";
                                                    @* var hasHold = holds?.Any(h => h.WalletId == selectedWallet.Id && h.MonthHold.Year == date.Year && h.MonthHold.Month == date.Month) == true; *@

                                                    if (hasHold != null)
                                                    {
                                                        cardStyle += " border: 2px solid #6610f2; box-shadow: 0 0 10px rgba(102,16,242,0.4);";
                                                    }
                                                    else
                                                    {
                                                        cardStyle += " box-shadow: 0 0 5px rgba(0,0,0,0.1);";
                                                    }

                                                    <div class="wallet-card bg-light rounded-3 p-3 text-dark" style="@cardStyle">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <div>
                                                                @* <h6 class="fw-bold mb-0">@selectedWallet.Name</h6> *@
                                                                <small class="fw-bold">@date.ToString("MMMM yyyy")</small>
                                                            </div>
                                                            <div class="text-end">
                                                                @if (lastMonthBalance.HasValue)
                                                                {
                                                                    <small class="text-muted" style="font-size: 0.75rem;">
                                                                        Opening Balance: @FormatAmount(@lastMonthBalance.Value, selectedWallet.Currency)
                                                                    </small>
                                                                    <br />
                                                                }
                                                            </div>
                                                        </div>

                                                        <hr class="my-2" />

                                                        @if (transactions.Any())
                                                        {
                                                            <div>
                                                                <table class="table no-inner-borders">
                                                                    <thead class="text-muted">
                                                                        <tr>
                                                                            <td class="fw-bold" style="font-size: 0.75rem;color: black !important;">Budget Summary</td>
                                                                        </tr>
                                                                    </thead>
                                                                    <tfoot>
                                                                        <tr>
                                                                            <td class="text-success" style="font-size: 0.75rem;">Total Income</td>
                                                                            <td class="text-end" style="font-size: 0.75rem;">
                                                                                +
                                                                                @FormatAmount(transactions.Where(t => t.IsIncome).Sum(t => t.Amount), selectedWallet.Currency)
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td class="text-danger" style="font-size: 0.75rem;">Total Expense</td>
                                                                            <td class="text-end" style="font-size: 0.75rem;">
                                                                                -
                                                                                @FormatAmount(transactions.Where(t => !t.IsIncome).Sum(t => t.Amount), selectedWallet.Currency)
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td class="text-primary" style="font-size: 0.75rem;">Total Surplus</td>
                                                                            <td class="text-end" style="font-size: 0.75rem;">
                                                                                @FormatAmount(transactions.Where(t => t.IsIncome).
                                                                                                                                                                                                              Sum(t => t.Amount) - transactions.Where(t => !t.IsIncome).Sum(t => t.Amount), selectedWallet.Currency)
                                                                            </td>
                                                                        </tr>
                                                                    </tfoot>
                                                                </table>
                                                            </div>


                                                            <div style="flex-grow: 1; overflow-y: auto;">
                                                                <table class="table table-sm table-borderless mb-0">
                                                                    <thead class="text-muted">
                                                                        <tr>
                                                                            <td class="fw-bold" style="font-size: 0.75rem; color: black !important;" colspan="2">
                                                                                Spending Breakdown
                                                                            </td>
                                                                        </tr>
                                                                    </thead>

                                                                    <tbody>
                                                                        @{
                                                                            decimal sum = @lastMonthBalance.Value;
                                                                        }
                                                                        @foreach (var group in transactions.GroupBy(t => t.Date.Date))
                                                                        {

                                                                            var firstTransaction = group.First();
                                                                            var remainingTransactions = group.Skip(1);
                                                                            sum += firstTransaction.IsIncome ? firstTransaction.Amount : -firstTransaction.Amount;

                                                                            <!-- Fila de la fecha con la primera transacción -->
                                                                            <tr class="position-relative transaction-row"
                                                                            style="background-color:@(firstTransaction.IsUnexpected ? "#e9ecef" : "transparent"); cursor:pointer;"
                                                                            @onmousedown="() => StartLongPress(firstTransaction.Id)"
                                                                            @onclick="() => ToggleOverlayIfSame(firstTransaction.Id)">

                                                                                <td style="font-size:0.75rem;">
                                                                                    @firstTransaction.Date.ToString("ddd dd MMM", CultureInfo.InvariantCulture)
                                                                                </td>

                                                                                <td class="@((firstTransaction.IsIncome ? "text-success" : "text-danger")) text-end" style="font-size: 0.75rem;">
                                                                                    @firstTransaction.Name | @(firstTransaction.IsIncome
                                                                           ? FormatAmount(firstTransaction.Amount, selectedWallet.Currency)
                                                                           : "-" + FormatAmount(firstTransaction.Amount, selectedWallet.Currency))
                                                                                    <br>
                                                                                    <span class="text-muted" style="font-size: 0.65rem;">
                                                                                        @FormatAmount(sum, selectedWallet.Currency)
                                                                                    </span>
                                                                                </td>

                                                                                @if (longPressTransactionId == firstTransaction.Id)
                                                                                {
                                                                                    <td class="p-0 position-absolute top-0 start-50 translate-middle-x" style="z-index:10;">
                                                                                        <div class="overlay-actions d-flex justify-content-center align-items-center bg-white shadow rounded p-2">
                                                                                            <button class="btn btn-light mx-2" @onclick="() => AddTithe(firstTransaction, true)">
                                                                                                <i class="bi bi-heart-fill fs-4 text-success"></i>
                                                                                            </button>
                                                                                            <button class="btn btn-light mx-2" @onclick="() => EditTransaction(firstTransaction.Id)">
                                                                                                <i class="bi bi-pencil-square fs-4 text-primary"></i>
                                                                                            </button>
                                                                                            <button class="btn btn-light mx-2" @onclick="() => DeleteTransaction(firstTransaction.Id)">
                                                                                                <i class="bi bi-trash fs-4 text-danger"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                    </td>
                                                                                }
                                                                            </tr>



                                                                            <!-- Filas para el resto de transacciones de ese día -->
                                                                            @foreach (var t in remainingTransactions)
                                                                            {
                                                                                sum += t.IsIncome ? t.Amount : -t.Amount;
                                                                                <tr class="position-relative transaction-row"
                                                                                style="background-color:@(t.IsUnexpected ? "#e9ecef" : "transparent"); cursor:pointer;"
                                                                                @onmousedown="() => StartLongPress(t.Id)"
                                                                                @onclick="() => ToggleOverlayIfSame(t.Id)">

                                                                                    <td></td> <!-- Fecha ya mostrada en la fila anterior -->
                                                                                    <td class="@((t.IsIncome ? "text-success" : "text-danger")) text-end" style="font-size: 0.75rem;">
                                                                                        @t.Name | @(t.IsIncome
                                                                ? FormatAmount(t.Amount, selectedWallet.Currency)
                                                                : "-" + FormatAmount(t.Amount, selectedWallet.Currency))
                                                                                        <br>
                                                                                        <span class="text-muted" style="font-size: 0.65rem;">
                                                                                            @FormatAmount(sum, selectedWallet.Currency)
                                                                                        </span>
                                                                                    </td>

                                                                                    @if (longPressTransactionId == t.Id)
                                                                                    {
                                                                                        <td class="p-0 position-absolute top-0 start-50 translate-middle-x" style="z-index:10;">
                                                                                            <div class="overlay-actions d-flex justify-content-center align-items-center bg-white shadow rounded p-2">
                                                                                                <button class="btn btn-light mx-2" @onclick="() => AddTithe(t, true)">
                                                                                                    <i class="bi bi-heart-fill fs-4 text-success"></i>
                                                                                                </button>
                                                                                                <button class="btn btn-light mx-2" @onclick="() => EditTransaction(t.Id)">
                                                                                                    <i class="bi bi-pencil-square fs-4 text-primary"></i>
                                                                                                </button>
                                                                                                <button class="btn btn-light mx-2" @onclick="() => DeleteTransaction(t.Id)">
                                                                                                    <i class="bi bi-trash fs-4 text-danger"></i>
                                                                                                </button>
                                                                                            </div>
                                                                                        </td>

                                                                                    }
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    </tbody>




                                                                </table>
                                                            </div>
                                                            <table style="border-top: 2px solid #33333363;">

                                                                @* <div class="text-end">

                                                <small class="fw-semibold text-end @(balance >= 0 ? "text-success" : "text-danger")">
                                                Closing Balance: @FormatAmount(balance, selectedWallet.Currency)
                                                </small>
                                                <br />

                                        </div> *@

                                                                <tfoot>
                                                                    <tr>
                                                                        @* <td class="fw-bold text-muted" style="font-size: 0.75rem;">Closing Balance</td> *@
                                                                        <td class="fw-semibold text-end text-muted" style="font-size: 0.75rem;">
                                                                            Closing Balance: @FormatAmount(balance, selectedWallet.Currency)
                                                                        </td>
                                                                    </tr>
                                                                </tfoot>

                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted" style="font-size: 0.75rem; flex-grow: 1;">No transactions this month.</div>
                                                        }


                                                        @if (hasHold != null)
                                                        {
                                                            <button class="btn btn-sm mt-2 btn-hold btn-hold"
                                                            @onclick="@(() => DeleteHold(hasHold.Id))">
                                                                <i class="bi bi-lock me-1"></i>
                                                                Unhold - @FormatAmount(hasHold.BalanceHold, selectedWallet.Currency)
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm mt-2 btn-unhold"
                                                            @onclick="@(() => SaveHold(selectedWallet.Id, currentDate, balance))">
                                                                <i class="bi bi-lock-fill me-1"></i>
                                                                Hold
                                                            </button>
                                                        }


                                                    </div>

                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p>No data loaded. Please apply filters.</p>
                                        }
                                    </div>
                                </Content>
                            </AccordionItem>
                        </Accordion>
                    </Content>
                </AccordionItem>
            }
        </Accordion>
    </div>
}
else
{
    <p class="text-muted">Select range.</p>
}


<!-- Modal: New Transaction -->
<div class="modal fade @(showModalTransaction ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <EditForm Model="transactionForm" OnValidSubmit="SaveTransaction">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="modal-header py-2">
                    <h6 class="modal-title mb-0">@transactionModalTitle - @selectedWallet?.Name</h6>
                    <button type="button" class="btn-close" @onclick="CloseModalTransaction"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">Date</label>
                            <InputDate class="form-control form-control-sm" @bind-Value="transactionForm.Date" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Amount</label>
                            <InputNumber class="form-control form-control-sm"
                            @bind-Value="transactionForm.Amount"
                            disabled="@(transactionForm.SubTransactions?.Any() == true)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Name</label>
                            <InputText class="form-control form-control-sm" @bind-Value="transactionForm.Name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Category</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="transactionForm.CategoryId">
                                <option value="">-- Select Category --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Description</label>
                            <InputText class="form-control form-control-sm" @bind-Value="transactionForm.Description" />
                        </div>
                        <div class="col-6">
                            <div class="form-check small">
                                <InputCheckbox class="form-check-input" @bind-Value="transactionForm.Tithe" id="isTitheCheck" />
                                <label class="form-check-label ms-1" for="isTitheCheck">Tithe?</label>
                            </div>
                        </div>
                        @* ... tu bloque de recurrencia aquí ... *@

                        @if (currentAction == ActionType.None || transactionForm.IsRecurring == false)
                        {
                            <div class="col-6">
                                <div class="form-check small">
                                    <InputCheckbox class="form-check-input" @bind-Value="transactionForm.IsRecurring" id="isRecurringCheck" />
                                    <label class="form-check-label ms-1" for="isRecurringCheck">Recurring?</label>
                                </div>
                            </div>

                            @if (transactionForm.IsRecurring)
                            {
                                <div class="col-6">
                                    <label class="form-label small">Interval</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="transactionForm.RecurrenceIntervalId">
                                        <option value="">-- Frequency --</option>
                                        @foreach (var interval in recurrenceIntervals)
                                        {
                                            <option value="@interval.Id">@interval.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => transactionForm.RecurrenceIntervalId)" />
                                </div>

                                @functions {
        string GetEnumDisplayName(Enum value)
        {
                            var member = value.GetType().GetMember(value.ToString()).FirstOrDefault();
                            return member?.GetCustomAttribute<DisplayAttribute>()?.Name ?? value.ToString();
        }
                        }

                                <div class="col-6">
                                    <label class="form-label small">Repeat</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="transactionForm.RecurrenceEndType">
                                        <option value="">-- Select end type --</option>
                                        @foreach (RecurrenceEndType item in Enum.GetValues(typeof(RecurrenceEndType)))
                                        {
                                            <option value="@item">@GetEnumDisplayName(item)</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => transactionForm.RecurrenceEndType)" />
                                </div>

                                @if (transactionForm.RecurrenceEndType == RecurrenceEndType.EndDate)
                                {
                                    <div class="col-6">
                                        <label class="form-label small">End Date</label>
                                        <InputDate class="form-control form-control-sm" @bind-Value="transactionForm.RecurrenceEndDate" />
                                        <ValidationMessage For="@(() => transactionForm.RecurrenceEndDate)" />
                                    </div>
                                }
                                else if (transactionForm.RecurrenceEndType == RecurrenceEndType.NumberOfOccurrences)
                                {
                                    <div class="col-6">
                                        <label class="form-label small">Number of Repetitions</label>
                                        <InputNumber class="form-control form-control-sm" @bind-Value="transactionForm.RecurrenceCount" />
                                        <ValidationMessage For="@(() => transactionForm.RecurrenceCount)" />
                                    </div>
                                }
                            }
                        }
                    </div>

                    <!-- SubTransactions Section -->
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Sub Transactions</h6>
                        <button type="button" class="btn btn-sm btn-success" @onclick="AddSubTransaction">
                            + Add Line
                        </button>
                    </div>

                    @if (transactionForm.SubTransactions?.Any() == true)
                    {
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 30%;">Name</th>
                                    <th style="width: 40%;">Description</th>
                                    <th style="width: 20%;">Amount</th>
                                    <th style="width: 10%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in transactionForm.SubTransactions)
                                {
                                    <tr @key="sub">
                                        <td>
                                            <InputText class="form-control form-control-sm"
                                            @bind-Value="sub.Name" />
                                            <ValidationMessage For="@(() => sub.Name)" />
                                        </td>
                                        <td>
                                            <InputText class="form-control form-control-sm"
                                            @bind-Value="sub.Description" />
                                        </td>
                                        <td class="d-flex align-items-center">
                                            <InputNumber class="form-control form-control-sm me-1"
                                            @bind-Value="sub.Amount" />
                                            <input type="checkbox" class="form-check-input"
                                            @onchange="e => OnSubAmountChecked(sub, e.Value as bool?)" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-danger"
                                            @onclick="() => RemoveSubTransaction(sub)">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    }
                </div>

                @if (!string.IsNullOrEmpty(transactionValidationError))
                {
                    <div class="alert alert-danger py-1 px-2 small mb-2" role="alert">
                        @transactionValidationError
                    </div>
                }

                <div class="modal-footer py-2">
                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseModalTransaction">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@if (showModalQuickNote)
{
