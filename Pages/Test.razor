        }
        else
        {
            DbContext.Transactions.RemoveRange(transactionsToDelete);
            await DbContext.SaveChangesAsync();
            CloseModalTransaction();
            await LoadData();
            showOptionsModal = false;
            showDeleteModal = false;
            currentAction = ActionType.None;

            // Obtener los meses únicos de las transacciones borradas
            var months = transactionsToDelete
                .Select(t => new DateTime(t.Date.Year, t.Date.Month, 1))
                .Distinct();

            await LoadTransactions(
                new DateTime(transactionsToDelete.Min(t => t.Date).Year,
                             transactionsToDelete.Min(t => t.Date).Month, 1),
                new DateTime(transactionsToDelete.Max(t => t.Date).Year,
                             transactionsToDelete.Max(t => t.Date).Month, 1)
            );


        }
        message = "Deletion";
        showSuccessModal = true;
    }

