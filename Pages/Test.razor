    public class SummaryColumn
    {
        public string Title { get; set; } = "";
        public decimal TotalIncome { get; set; }
        public decimal TotalExpense { get; set; }
        public decimal TotalSurplus => TotalIncome - TotalExpense; // NO se asigna
        public List<Transaction> Transactions { get; set; } = new();
    }


    private async Task BuildSemesterSummary(int year, int semester, DateTime startMonth, DateTime endMonth)
    {
        await LoadTransactions(startMonth, endMonth);

        // Reinicia la lista
        summaryColumns = new List<SummaryColumn>();

        var transactions = groupedTransactions.Values.SelectMany(t => t).ToList();

        decimal cumulativeIncome = 0;
        decimal cumulativeExpense = 0;
        var cumulativeTx = new List<Transaction>();

        // --- Meses individuales (ACUMULADOS) ---
        for (int m = startMonth.Month; m <= endMonth.Month; m++)
        {
            var monthTx = transactions
                .Where(t => t.Date.Year == year &&
                            t.Date.Month == m &&
                            t.WalletId == selectedWallet.Id)
                .OrderBy(t => t.Date)
                .ToList();

            cumulativeIncome += monthTx.Where(t => t.IsIncome).Sum(t => t.Amount);
            cumulativeExpense += monthTx.Where(t => !t.IsIncome).Sum(t => t.Amount);
            cumulativeTx.AddRange(monthTx);

            summaryColumns.Add(new SummaryColumn
                {
                    Title = new DateTime(year, m, 1).ToString("MMM"),
                    TotalIncome = cumulativeIncome,
                    TotalExpense = cumulativeExpense,
                    Transactions = cumulativeTx.ToList() // transacciones acumulativas
                });
        }

        // --- Q1 (acumulado hasta el último mes del Q1) ---
        // Después de agregar 6 meses (idx 0..5), marzo es idx 2.
        summaryColumns.Insert(3, new SummaryColumn
            {
                Title = "Q1",
                TotalIncome = summaryColumns[2].TotalIncome,
                TotalExpense = summaryColumns[2].TotalExpense,
                Transactions = summaryColumns[2].Transactions.ToList()
            });

        // --- Q2 (acumulado hasta el último mes del Q2) ---
        // Tras insertar Q1 en idx 3, junio queda en idx 6.
        int endOfSemesterIndex = 6;
        summaryColumns.Insert(7, new SummaryColumn
            {
                Title = "Q2",
                TotalIncome = summaryColumns[endOfSemesterIndex].TotalIncome,
                TotalExpense = summaryColumns[endOfSemesterIndex].TotalExpense,
                Transactions = summaryColumns[endOfSemesterIndex].Transactions.ToList()
            });

        // --- Semestre completo (acumulado final) ---
        summaryColumns.Add(new SummaryColumn
            {
                Title = $"S {semester}",
                TotalIncome = summaryColumns[endOfSemesterIndex].TotalIncome,
                TotalExpense = summaryColumns[endOfSemesterIndex].TotalExpense,
                Transactions = summaryColumns[endOfSemesterIndex].Transactions.ToList()
            });
    }

