    private async Task LoadTransactionsList(int year)
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var result = await db.Transactions
                .Where(t => t.WalletId == selectedWallet.Id && t.Date.Year == year)
                .OrderBy(t => t.Date)
                .ToListAsync();

            Transactions[(selectedWallet.Id, year)] = result;

            // También carga los pronósticos del año
            var forecasts = await GetForecastsByYearAsync(year);
            BudgetForecasts[(selectedWallet.Id, year)] = forecasts;
        }
        finally
        {
            _isLoading = false;
        }
    }

