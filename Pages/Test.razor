@page "/tests"
@using BlazorBootstrap
@using Budget1.Data
@using Budget1.Models
@inject Budget1.Data.BudgetDbContext DbContext
@inject IDbContextFactory<BudgetDbContext> DbFactory
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@using WYSIWYGTextEditor

<Toasts class="p-3" Messages="messages" AutoHide="true" StackLength="3" Placement="ToastsPlacement.TopRight" />

<PageTitle>Wallets</PageTitle>

<h3>Wallets</h3>

<div class="mb-3 d-flex align-items-end gap-2">
    <!-- Filtro desde año -->
    <div>
        <label for="fromYear" class="form-label">From Year</label>
        <InputSelect @bind-Value="FromYear" class="form-select">
            @foreach (var year in AvailableYears)
            {
                <option value="@year">@year</option>
            }
        </InputSelect>
    </div>

    <!-- Filtro hasta año -->
    <div>
        <label for="toYear" class="form-label">To Year</label>
        <InputSelect @bind-Value="ToYear" class="form-select">
            @foreach (var year in AvailableYears)
            {
                <option value="@year">@year</option>
            }
        </InputSelect>
    </div>

    <!-- Botón aplicar filtro -->
    <button class="btn btn-primary" @onclick="ApplyFilter">
        Apply Filter
    </button>
</div>

@if (FilteredYears.Any())
{
    <div style="width:80vw; margin:auto;">
        <Accordion AlwaysOpen="true" class="mb-2">
            @foreach (var year in FilteredYears)
            {
                <AccordionItem>
                    <TitleTemplate>
                        <Icon Name="IconName.Calendar2CheckFill" Class="me-1" /> @year.ToString()
                    </TitleTemplate>
                    <Content>
                        <!-- Forecast -->
                        <Accordion @ref="accordionf">
                            <AccordionItem @onclick="() => LoadTransactionsList(year)">
                                <TitleTemplate>
                                    <Icon Name="IconName.CloudFill" Class="me-1" /> Forecast
                                </TitleTemplate>
                                <Content>
                                    @if (Transactions.Any())
                                    {
                                        var transactions = Transactions.GetValueOrDefault((selectedWallet.Id, year), new List<Transaction>());
                                        <div class="mb-6">
                                            @*           <h3 class="text-lg font-semibold mb-2 text-gray-700 dark:text-gray-200">
                                                Selecciona una transacción existente
                                            </h3> *@

                                            <div class="flex gap-2 items-center flex-wrap">
                                                <select class="border rounded px-3 py-2 w-72 dark:bg-gray-800 dark:text-gray-200"
                                                @bind="SelectedTransactionId">
                                                    <option value="">-- Select --</option>
                                                    @foreach (var t in transactions)
                                                    {
                                                        <option value="@t.Id">@t.Name (@t.Amount.ToString("C", CultureInfo.CurrentCulture))</option>
                                                    }
                                                </select>

                                                <button class="bg-green-600 px-4 py-2 rounded hover:bg-green-700 transition"
                                                @onclick="async () => await AddSelectedTransactionToForecast(
                                                        transactions.FirstOrDefault(x => x.Id == SelectedTransactionId), year)"
                                                disabled="@(!SelectedTransactionId.HasValue)">
                                                    Add
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Nueva transacción manual -->
                                    <div class="mb-8">
                                        @* <h3 class="text-lg font-semibold mb-2 text-gray-700 dark:text-gray-200">
                                            O agrega una nueva transacción
                                        </h3> *@

                                        <div class="flex flex-wrap gap-2 items-center">
                                            <input type="text"
                                            placeholder="Forecast Name"
                                            class="border rounded px-3 py-2 w-64 dark:bg-gray-800 dark:text-gray-200"
                                            @bind="NewTransactionName" />

                                            <input type="number"
                                            placeholder="Amount"
                                            step="0.01"
                                            class="border rounded px-3 py-2 w-40 dark:bg-gray-800 dark:text-gray-200"
                                            @bind="NewTransactionAmount" />

                                            <button class="bg-blue-600 px-4 py-2 rounded hover:bg-blue-700 transition"
                                            @onclick="async () => await AddManualTransactionToForecast(year)"
                                            disabled="@(string.IsNullOrWhiteSpace(NewTransactionName) || NewTransactionAmount <= 0)">
                                                Add
                                            </button>
                                        </div>
                                    </div>

                                    @{
                                        // Obtiene la lista del diccionario según la wallet y año seleccionados
                                        var forecasts = BudgetForecasts.GetValueOrDefault((selectedWallet.Id, year), new List<BudgetForecast>());
                                    }

                                    @if (forecasts.Any())
                                    {
                                        <div class="overflow-x-auto">
                                            <table class="min-w-full text-sm border border-gray-300 dark:border-gray-700 rounded-lg shadow-sm">
                                                <thead class="bg-blue-600 text-xs uppercase">
                                                    <tr>
                                                        <th class="px-4 py-3 text-left">Transaction Name</th>
                                                        <th class="px-3 py-3 text-right">Daily</th>
                                                        <th class="px-3 py-3 text-right">Weekly</th>
                                                        <th class="px-3 py-3 text-right">Monthly</th>
                                                        <th class="px-3 py-3 text-right">Semester</th>
                                                        <th class="px-3 py-3 text-right">Yearly</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in forecasts)
                                                    {
                                                        <tr class="border-t hover:bg-blue-50 dark:hover:bg-gray-800 transition">
                                                            <td class="px-4 py-2 font-medium text-gray-800 dark:text-gray-200">@item.TransactionName</td>
                                                            <td class="px-3 py-2 text-right">@item.Daily.ToString("C", CultureInfo.CurrentCulture)</td>
                                                            <td class="px-3 py-2 text-right">@item.Weekly.ToString("C", CultureInfo.CurrentCulture)</td>
                                                            <td class="px-3 py-2 text-right font-semibold text-blue-700 dark:text-blue-400">@item.Monthly.ToString("C", CultureInfo.CurrentCulture)</td>
                                                            <td class="px-3 py-2 text-right">@item.Semester.ToString("C", CultureInfo.CurrentCulture)</td>
                                                            <td class="px-3 py-2 text-right">@item.Yearly.ToString("C", CultureInfo.CurrentCulture)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-gray-600 dark:text-gray-300 mt-4">No records.</p>
                                    }
                                </Content>
                            </AccordionItem>
                        </Accordion>

                        <!-- First Semester Statement -->
                        <Accordion @ref="accordion1"
                        OnShowing="OnShowingAsync"
                        OnShown="OnShownAsync">
                            @{
                                DateTime FstartMonth = new DateTime(year, 1, 1);
                                DateTime FendMonth = new DateTime(year, 6, 1);
                                HideSecondAccordionItemAsync();
                            }
                            <AccordionItem @onclick="() => LoadTransactions(FstartMonth, FendMonth)">
                                <TitleTemplate>
                                    <Icon Name="IconName.OneSquareFill" Class="me-1" /> Semester
                                </TitleTemplate>
                                <Content>
                                    <Spinner Class="me-3" Type="SpinnerType.Dots" Color="SpinnerColor.Primary" Visible="@visible" />


                                    <div class="col-md-12">
                                        @if (groupedTransactions?.Any() == true)
                                        {
                                            <div class="d-flex flex-wrap gap-3">
                                                @for (var date = FstartMonth; date <= FendMonth; date = date.AddMonths(1))

                                                {
                                                    var transactions = groupedTransactions.GetValueOrDefault((selectedWallet, date), new List<Transaction>());
                                                    var balance = cumulativeBalances.GetValueOrDefault((selectedWallet.Id, date), 0);
                                                    var currentDate = date;

                                                    Hold hasHold = holds.FirstOrDefault(h => h.WalletId == selectedWallet.Id && h.MonthHold.Year == date.Year && h.MonthHold.Month == date.Month);

                                                    // Buscar balance del mes anterior en PreviousBalances
                                                    var previousMonth = date.AddMonths(-1);
                                                    decimal? lastMonthBalance = null;

                                                    var prevRecord = previousBalances
                                                    .FirstOrDefault(pb => pb.Month.Year == previousMonth.Year
                                                    && pb.Month.Month == previousMonth.Month);

                                                    if (prevRecord != null)
                                                    {
                                                        lastMonthBalance = prevRecord.Balance;
                                                    }
                                                    else if (selectedWallet.CreatedDate.Year == date.Year
                                                    && selectedWallet.CreatedDate.Month == date.Month)
                                                    {
                                                        // Si es el mes de creación, usamos el InitialBalance
                                                        lastMonthBalance = selectedWallet.InitialBalance;
                                                    }

                                                    var cardStyle = "width: 300px; min-height: 300px; max-height: 400px; overflow: hidden; display: flex; flex-direction: column;";
                                                    @* var hasHold = holds?.Any(h => h.WalletId == selectedWallet.Id && h.MonthHold.Year == date.Year && h.MonthHold.Month == date.Month) == true; *@

                                                    if (hasHold != null)
                                                    {
                                                        cardStyle += " border: 2px solid #6610f2; box-shadow: 0 0 10px rgba(102,16,242,0.4);";
                                                    }
                                                    else
                                                    {
                                                        cardStyle += " box-shadow: 0 0 5px rgba(0,0,0,0.1);";
                                                    }

                                                    <div class="wallet-card bg-light rounded-3 p-3 text-dark" style="@cardStyle">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <div>
                                                                @* <h6 class="fw-bold mb-0">@selectedWallet.Name</h6> *@
                                                                <small class="fw-bold">@date.ToString("MMMM yyyy")</small>
                                                            </div>
                                                            <div class="text-end">
                                                                @if (lastMonthBalance.HasValue)
                                                                {
                                                                    <small class="text-muted" style="font-size: 0.75rem;">
                                                                        Opening Balance: @FormatAmount(@lastMonthBalance.Value, selectedWallet.Currency)
                                                                    </small>
                                                                    <br />
                                                                }
                                                            </div>
                                                        </div>

                                                        <hr class="my-2" />

                                                        @if (transactions.Any())
                                                        {
                                                            <div>
                                                                <table class="table no-inner-borders">
                                                                    <thead class="text-muted">
                                                                        <tr>
                                                                            <td class="fw-bold" style="font-size: 0.75rem;color: black !important;">Budget Summary</td>
                                                                        </tr>
                                                                    </thead>
                                                                    <tfoot>
                                                                        <tr>
                                                                            <td class="text-success" style="font-size: 0.75rem;">Total Income</td>
                                                                            <td class="text-end" style="font-size: 0.75rem;">
                                                                                +
                                                                                @FormatAmount(transactions.Where(t => t.IsIncome).Sum(t => t.Amount), selectedWallet.Currency)
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td class="text-danger" style="font-size: 0.75rem;">Total Expense</td>
                                                                            <td class="text-end" style="font-size: 0.75rem;">
                                                                                -
                                                                                @FormatAmount(transactions.Where(t => !t.IsIncome).Sum(t => t.Amount), selectedWallet.Currency)
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td class="text-primary" style="font-size: 0.75rem;">Total Surplus</td>
                                                                            <td class="text-end" style="font-size: 0.75rem;">
                                                                                @FormatAmount(transactions.Where(t => t.IsIncome).
                                                                                                                                      Sum(t => t.Amount) - transactions.Where(t => !t.IsIncome).Sum(t => t.Amount), selectedWallet.Currency)
                                                                            </td>
                                                                        </tr>
                                                                    </tfoot>
                                                                </table>
                                                            </div>


                                                            <div style="flex-grow: 1; overflow-y: auto;">
                                                                <table class="table table-sm table-borderless mb-0">
                                                                    <thead class="text-muted">
                                                                        <tr>
                                                                            <td class="fw-bold" style="font-size: 0.75rem; color: black !important;" colspan="2">
                                                                                Spending Breakdown
                                                                            </td>
                                                                        </tr>
                                                                    </thead>

                                                                    <tbody>
                                                                        @{
                                                                            decimal sum = @lastMonthBalance.Value;
                                                                        }
                                                                        @foreach (var group in transactions.GroupBy(t => t.Date.Date))
                                                                        {

                                                                            var firstTransaction = group.First();
                                                                            var remainingTransactions = group.Skip(1);
                                                                            sum += firstTransaction.IsIncome ? firstTransaction.Amount : -firstTransaction.Amount;

                                                                            <!-- Fila de la fecha con la primera transacción -->
                                                                            <tr class="position-relative transaction-row"
                                                                            style="background-color:@(firstTransaction.IsUnexpected ? "#e9ecef" : "transparent"); cursor:pointer;"
                                                                            @onmousedown="() => StartLongPress(firstTransaction.Id)"
                                                                            @onclick="() => ToggleOverlayIfSame(firstTransaction.Id)">

                                                                                <td class="" style="font-size:0.75rem;">
                                                                                    @firstTransaction.Date.ToString("ddd dd MMM", CultureInfo.InvariantCulture)
                                                                                </td>

                                                                                <td class="@((firstTransaction.IsIncome ? "text-success" : "text-danger")) text-end" style="font-size: 0.75rem;">
                                                                                    @firstTransaction.Name | @(firstTransaction.IsIncome
                                                               ? FormatAmount(firstTransaction.Amount, selectedWallet.Currency)
                                                               : "-" + FormatAmount(firstTransaction.Amount, selectedWallet.Currency))
                                                                                    <br>
                                                                                    <span class="text-muted" style="font-size: 0.65rem;">
                                                                                        @FormatAmount(sum, selectedWallet.Currency)
                                                                                    </span>
                                                                                </td>

                                                                                @if (longPressTransactionId == firstTransaction.Id)
                                                                                {
                                                                                    <td colspan="2" class="p-0">
                                                                                        <div class="overlay-actions d-flex justify-content-center align-items-center">
                                                                                            <button class="btn btn-light mx-2 shadow" @onclick="() => AddTithe(firstTransaction, true)">
                                                                                                <i class="bi bi-heart-fill fs-4 text-success"></i>
                                                                                            </button>
                                                                                            <button class="btn btn-light mx-2 shadow" @onclick="() => EditTransaction(firstTransaction.Id)">
                                                                                                <i class="bi bi-pencil-square fs-4 text-primary"></i>
                                                                                            </button>
                                                                                            <button class="btn btn-light mx-2 shadow" @onclick="() => DeleteTransaction(firstTransaction.Id)">
                                                                                                <i class="bi bi-trash fs-4 text-danger"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                    </td>
                                                                                }
                                                                            </tr>

                                                                            <!-- Filas para el resto de transacciones de ese día -->
                                                                            @foreach (var t in remainingTransactions)
                                                                            {
                                                                                sum += t.IsIncome ? t.Amount : -t.Amount;
                                                                                <tr class="position-relative transaction-row"
                                                                                style="background-color:@(t.IsUnexpected ? "#e9ecef" : "transparent"); cursor:pointer;"
                                                                                @onmousedown="() => StartLongPress(t.Id)"
                                                                                @onclick="() => ToggleOverlayIfSame(t.Id)">

                                                                                    <td></td> <!-- Fecha ya mostrada en la fila anterior -->
                                                                                    <td class="@((t.IsIncome ? "text-success" : "text-danger")) text-end" style="font-size: 0.75rem;">
                                                                                        @t.Name | @(t.IsIncome
                                                                ? FormatAmount(t.Amount, selectedWallet.Currency)
                                                                : "-" + FormatAmount(t.Amount, selectedWallet.Currency))
                                                                                        <br>
                                                                                        <span class="text-muted" style="font-size: 0.65rem;">
                                                                                            @FormatAmount(sum, selectedWallet.Currency)
                                                                                        </span>
                                                                                    </td>

                                                                                    @if (longPressTransactionId == t.Id)
                                                                                    {
                                                                                        <td colspan="2" class="p-0">
                                                                                            <div class="overlay-actions d-flex justify-content-center align-items-center">
                                                                                                <button class="btn btn-light mx-2 shadow" @onclick="() => AddTithe(t, true)">
                                                                                                    <i class="bi bi-heart-fill fs-4 text-success"></i>
                                                                                                </button>
                                                                                                <button class="btn btn-light mx-2 shadow" @onclick="() => EditTransaction(t.Id)">
                                                                                                    <i class="bi bi-pencil-square fs-4 text-primary"></i>
                                                                                                </button>
                                                                                                <button class="btn btn-light mx-2 shadow" @onclick="() => DeleteTransaction(t.Id)">
                                                                                                    <i class="bi bi-trash fs-4 text-danger"></i>
                                                                                                </button>
                                                                                            </div>
                                                                                        </td>
                                                                                    }
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    </tbody>




                                                                </table>
                                                            </div>
                                                            <table style="border-top: 2px solid #33333363;">
                                                                <tfoot>
                                                                    <tr>
                                                                        @* <td class="fw-bold text-muted" style="font-size: 0.75rem;">Closing Balance</td> *@
                                                                        <td class="fw-semibold text-end text-muted" style="font-size: 0.75rem;">
                                                                            Closing Balance: @FormatAmount(balance, selectedWallet.Currency)
                                                                        </td>
                                                                    </tr>
                                                                </tfoot>

                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted" style="font-size: 0.75rem; flex-grow: 1;">No transactions this month.</div>
                                                        }


                                                        @if (hasHold != null)
                                                        {
                                                            <button class="btn btn-sm mt-2 btn-hold btn-hold"
                                                            @onclick="@(() => DeleteHold(hasHold.Id))">
                                                                <i class="bi bi-lock me-1"></i>
                                                                Unhold - @FormatAmount(hasHold.BalanceHold, selectedWallet.Currency)
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm mt-2 btn-unhold"
                                                            @onclick="@(() => SaveHold(selectedWallet.Id, currentDate, balance))">
                                                                <i class="bi bi-lock-fill me-1"></i>
                                                                Hold
                                                            </button>
                                                        }


                                                    </div>


                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p>No data loaded. Please apply filters.</p>
                                        }
                                    </div>



                                </Content>
                            </AccordionItem>
                        </Accordion>

                        <!-- Second Semester Statement -->
                        <Accordion @ref="accordion2"
                        OnShowing="OnShowingAsync"
                        OnShown="OnShownAsync">
                            @{
                                DateTime SstartMonth = new DateTime(year, 7, 1);
                                DateTime SendMonth = new DateTime(year, 12, 1);
                                HideFirstAccordionItemAsync();
                            }
                            <AccordionItem @onclick="() => LoadTransactions(SstartMonth, SendMonth)">
                                <TitleTemplate>
                                    <Icon Name="IconName.TwoSquareFill" Class="me-1" /> Semester
                                </TitleTemplate>
                                <Content>
                                    <Spinner Class="me-3" Type="SpinnerType.Dots" Color="SpinnerColor.Primary" Visible="@visible"/>
                                    <div class="col-md-12">
                                        @if (groupedTransactions?.Any() == true)
