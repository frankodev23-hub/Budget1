    private void SaveQuickNote()
    {
        if (quickNoteForm == null || string.IsNullOrWhiteSpace(quickNoteForm.Title))
            return;

        if (quickNoteForm.Id == 0) // Nueva nota
        {
            DbContext.QuickNotes.Add(quickNoteForm);

            if (quickNoteForm.Items != null)
            {
                foreach (var item in quickNoteForm.Items)
                {
                    DbContext.QuickNoteItems.Add(item);
                }
            }

            quickNotes.Add(quickNoteForm); // Refrescar la lista
        }
        else // Editar nota existente
        {
            DbContext.QuickNotes.Update(quickNoteForm);

            if (quickNoteForm.Items != null)
            {
                foreach (var item in quickNoteForm.Items)
                {
                    if (item.Id == 0) // Item nuevo
                        DbContext.QuickNoteItems.Add(item);
                    else // Item existente
                        DbContext.QuickNoteItems.Update(item);
                }
            }

            // Refrescar la lista local
            var index = quickNotes.FindIndex(n => n.Id == quickNoteForm.Id);
            if (index != -1)
                quickNotes[index] = quickNoteForm;
        }

        DbContext.SaveChanges();

        // Limpiar formulario
        quickNoteForm = new QuickNote();
        showNewNoteForm = false;
        showNoteList = true;
        showButtonAddNoteList = true;
    }

