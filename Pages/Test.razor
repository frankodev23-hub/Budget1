    private async Task LoadData()
    {
        using var context = DbFactory.CreateDbContext();

        wallets = await context.Wallets
            .OrderByDescending(w => w.CreatedDate)
            .ToListAsync();

        categories = await context.Categories.ToListAsync();

        quickNotes = await context.QuickNotes
            .Include(q => q.Items)
            .Include(q => q.Category)
            .OrderByDescending(q => q.Date)
            .ToListAsync();

        noteCategories = await context.QuickNoteCategories.ToListAsync();

        recurrenceIntervals = await context.RecurrenceIntervals
            .OrderBy(i => i.Name)
            .ToListAsync();

        holds = await context.Holds.ToListAsync();

        note = await context.Notes.FirstOrDefaultAsync();

        // ─────────────────────────────────────
        // Wallet seleccionada
        // ─────────────────────────────────────

        if (!selectedWalletId.HasValue)
        {
            selectedWallet = null;
            groupedTransactions.Clear();
            cumulativeBalances.Clear();
            return;
        }

        selectedWallet = wallets.FirstOrDefault(w => w.Id == selectedWalletId.Value);

        if (selectedWallet == null)
        {
            groupedTransactions.Clear();
            cumulativeBalances.Clear();
            return;
        }

        // Recalcular balances previos (usa SU propio DbContext)
        await RecalculatePreviousBalancesAsync(selectedWallet.Id);

        // Cargar PreviousBalances con ESTE contexto
        previousBalances = await context.PreviousBalances
            .Where(pb => pb.WalletId == selectedWallet.Id)
            .ToListAsync();

        // ─────────────────────────────────────
        // Fechas
        // ─────────────────────────────────────

        var today = DateTime.Today;

        if (selectedWallet.CreatedDate != DateTime.MinValue)
        {
            startMonth ??= new DateTime(
                selectedWallet.CreatedDate.Year,
                selectedWallet.CreatedDate.Month,
                1);
        }
        else
        {
            startMonth ??= new DateTime(today.Year, today.Month, 1);
        }

        endMonth ??= new DateTime(today.Year, today.Month, 1);

        // Aplicar filtros finales
        await ApplyFilter();
    }


    private async Task ApplyFilter()
    {
        if (FromYear <= ToYear)
        {
            FilteredYears = Enumerable.Range(FromYear, ToYear - FromYear + 1).ToList();
        }
        else
        {
            FilteredYears.Clear();
        }


        StateHasChanged();
    }

