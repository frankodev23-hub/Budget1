    public async Task RecalculatePreviousBalancesAsync(int walletId)
    {
        using var context = DbFactory.CreateDbContext();

        var wallet = await context.Wallets.FindAsync(walletId);
        if (wallet == null) return;

        // Traemos todas las transacciones de esa wallet, ordenadas
        var transactions = await context.Transactions
            .Where(t => t.WalletId == walletId)
            .OrderBy(t => t.Date)
            .ToListAsync();

        // Limpiamos los previous balances existentes
        var existing = await context.PreviousBalances
            .Where(pb => pb.WalletId == walletId)
            .ToListAsync();

        context.PreviousBalances.RemoveRange(existing);
        await context.SaveChangesAsync();

        // Balance inicial
        decimal runningBalance = wallet.InitialBalance;

        // Mes de inicio (creación de la wallet)
        DateTime startDate = new DateTime(
            wallet.CreatedDate.Year,
            wallet.CreatedDate.Month,
            1);

        // Último mes con transacciones
        DateTime lastTransactionMonth = transactions.Any()
            ? new DateTime(
                transactions.Max(t => t.Date).Year,
                transactions.Max(t => t.Date).Month,
                1)
            : startDate;

        // Iteramos mes a mes
        for (var date = startDate; date <= lastTransactionMonth; date = date.AddMonths(1))
        {
            var monthStart = new DateTime(date.Year, date.Month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);

            var monthTxs = transactions
                .Where(t => t.Date >= monthStart && t.Date <= monthEnd)
                .ToList();

            runningBalance += monthTxs.Sum(t =>
                t.IsIncome ? t.Amount : -t.Amount);

            context.PreviousBalances.Add(new PreviousBalance
                {
                    WalletId = walletId,
                    Month = monthStart,
                    Balance = runningBalance
                });
        }

        await context.SaveChangesAsync();
    }


