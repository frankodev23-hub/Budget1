    private DateTime CalculateNextDate(DateTime currentDate, RecurrenceInterval interval)
    {
        // Si DaysInterval es mayor que cero, se usa directamente
        if (interval.DaysInterval > 0)
        {
            return currentDate.AddDays(interval.DaysInterval);
        }

        // Si DaysInterval es 0, se usa el Name para calcular el próximo
        return interval.Name switch
        {
            "Monthly" => currentDate.AddMonths(1),
            "Quarterly" => currentDate.AddMonths(3),
            "Semester" => currentDate.AddMonths(6),
            "Yearly" => currentDate.AddYears(1),
            _ => currentDate.AddDays(1) // Fallback por defecto si no hay coincidencia
        };
    }

    string GetCultureFromCurrency(string? currency)
    {
        return currency switch
        {
            "USD" => "en-US",
            "EUR" => "fr-FR",
            "GBP" => "en-GB",
            "BOB" => "es-BO",
            "PEN" => "es-PE",
            "CLP" => "es-CL",
            "BRL" => "pt-BR",
            _ => "en-US"
        };
    }

    private void AddSubTransaction()
    {
        if (transactionForm.SubTransactions == null)
            transactionForm.SubTransactions = new List<SubTransaction>();

        var newSub = new SubTransaction();
        transactionForm.SubTransactions.Add(newSub);

        // No actualizamos el monto principal automáticamente; el usuario lo hace con el checkbox
    }

    private void RemoveSubTransaction(SubTransaction sub)
    {
        // Si la subtransaction estaba marcada como sumada, restamos su monto
        if (sub.IsChecked)
            transactionForm.Amount -= sub.Amount;

        transactionForm.SubTransactions?.Remove(sub);
    }

    private void OnSubAmountChecked(SubTransaction sub, bool? isChecked)
    {
        sub.IsChecked = isChecked == true;

        if (sub.IsChecked)
            transactionForm.Amount += sub.Amount;
        else
        {
            transactionForm.Amount -= sub.Amount;
            if (transactionForm.Amount < 0)
                transactionForm.Amount = 0;
        }
    }

    public async Task RecalculatePreviousBalancesAsync(int walletId)
    {
        var wallet = await DbContext.Wallets.FindAsync(walletId);
        if (wallet == null) return;

        // Traemos todas las transacciones de esa cartera, ordenadas
        var transactions = await DbContext.Transactions
            .Where(t => t.WalletId == walletId)
            .OrderBy(t => t.Date)
            .ToListAsync();

        // Limpiamos los previous balances existentes de esa wallet
        var existing = DbContext.PreviousBalances.Where(pb => pb.WalletId == walletId);
        DbContext.PreviousBalances.RemoveRange(existing);
        await DbContext.SaveChangesAsync();

        // Iniciamos balance con el saldo inicial
        decimal runningBalance = wallet.InitialBalance;
        // Arrancamos en el mes de creación
        DateTime startDate = new DateTime(wallet.CreatedDate.Year, wallet.CreatedDate.Month, 1);

        // Buscamos la fecha de la última transacción registrada
        DateTime lastTransactionMonth = transactions.Any()
            ? new DateTime(transactions.Max(t => t.Date).Year, transactions.Max(t => t.Date).Month, 1)
            : startDate; // Si no hay transacciones, usamos la fecha de creación

        // Iteramos desde la creación hasta la última transacción
        for (var date = startDate; date <= lastTransactionMonth; date = date.AddMonths(1))
        {
            var monthStart = new DateTime(date.Year, date.Month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);

            var monthTxs = transactions
                .Where(t => t.Date >= monthStart && t.Date <= monthEnd)
                .ToList();

            runningBalance += monthTxs.Sum(t => t.IsIncome ? t.Amount : -t.Amount);

            var prevBalance = new PreviousBalance
                {
                    WalletId = walletId,
                    Month = monthStart,
                    Balance = runningBalance
                };

            DbContext.PreviousBalances.Add(prevBalance);
        }

        await DbContext.SaveChangesAsync();
    }

