@code {

    List<Wallet>? wallets;
    Wallet walletForm = new();
    bool isEditing = false;
    int? selectedWalletId;
    Wallet? selectedWallet;
    bool isZoomed = false;

    bool showModal = false;

    decimal monthlyBudgetAmount;

    string? deleteErrorMessage = null;

    record CurrencyOption(string Code, string Name, string Symbol);
    private List<string> themes = new()
{
    "blue",
    "red",
    "green",
    "orange",
    "purple",
    "yellow",
    "teal",
    "gray",
    "pink",
    "brown",
    "turquoise",
    "black"
};

    private List<Transaction> allTransactions = new List<Transaction>();


    void ViewWallet(int walletId)
    {
        NavigationManager.NavigateTo($"/budgets?walletId={walletId}");
    }

    List<CurrencyOption> currencyOptions = new()
    {
        new CurrencyOption("USD", "US Dollar", "$"),
        new CurrencyOption("EUR", "Euro", "€"),
        new CurrencyOption("GBP", "British Pound", "£"),
        new CurrencyOption("BOB", "Bolivian Peso", "Bs."),
        new CurrencyOption("PEN", "Peruvian Sol", "S/"),
        new CurrencyOption("BRL", "Brazilian Real", "R$"),
    };

    private async Task OnWalletListUpdate(SortableListEventArgs args)
    {
        // Reordenamos la lista local
        var itemToMove = wallets[args.OldIndex];
        wallets.RemoveAt(args.OldIndex);

        if (args.NewIndex < wallets.Count)
            wallets.Insert(args.NewIndex, itemToMove);
        else
            wallets.Add(itemToMove);

        // Reasignamos nuevas posiciones
        for (int i = 0; i < wallets.Count; i++)
        {
            wallets[i].Position = i;
        }

        // Guardamos los cambios en la base de datos
        foreach (var wallet in wallets)
        {
            DbContext.Wallets.Update(wallet);
        }

        await DbContext.SaveChangesAsync();

        StateHasChanged();
    }



    protected override async Task OnInitializedAsync()
    {
        await LoadWallets();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("makeDraggableWithHandle", "floatingContainer", "dragHandle");
        }
    }

    async Task LoadWallets()
    {
        wallets = await DbContext.Wallets
        .Include(w => w.MonthlyBudgets) // Incluye los presupuestos mensuales
        .OrderBy(w => w.Position)
        .ToListAsync();

        // 2. Cargar todas las transacciones de todos los wallets
        allTransactions = await DbContext.Transactions
            .Where(t => wallets.Select(w => w.Id).Contains(t.WalletId))
            .ToListAsync();
    }

    private async Task<List<Transaction>> GetWalletTransactionsAsync(int walletId)
    {
        return await DbContext.Transactions
            .Where(t => t.WalletId == walletId)
            .ToListAsync();
    }


    void ShowCreateModal()
    {
        walletForm = new();
        walletForm.CreatedDate = DateTime.Now; // Establece la fecha de creación al momento actual
        isEditing = false;
        showModal = true;
    }

    void EditWallet(Budget1.Models.Wallet wallet)
    {
        walletForm = new Budget1.Models.Wallet
            {
                Id = wallet.Id,
                Name = wallet.Name,
                Balance = wallet.Balance,
                InitialBalance = wallet.InitialBalance,
                Currency = wallet.Currency,
                CreatedDate = wallet.CreatedDate,
                Theme = wallet.Theme,
                MonthlyBudgets = wallet.MonthlyBudgets
            };

        var currentBudget = wallet.MonthlyBudgets.FirstOrDefault(b => b.Year == DateTime.Now.Year && b.Month == DateTime.Now.Month);
        monthlyBudgetAmount = currentBudget?.BudgetAmount ?? 0;

        isEditing = true;
        showModal = true;
    }

    async Task SaveWallet()
    {
        if (isEditing)
        {
            var existing = await DbContext.Wallets
                .Include(w => w.MonthlyBudgets)
                .FirstOrDefaultAsync(w => w.Id == walletForm.Id);

            if (existing != null)
            {
                existing.Name = walletForm.Name;
                existing.Balance = walletForm.Balance;
                existing.InitialBalance = walletForm.InitialBalance;
                existing.CreatedDate = walletForm.CreatedDate;
                existing.Currency = walletForm.Currency;
                existing.Theme = string.IsNullOrWhiteSpace(walletForm.Theme)? "default": walletForm.Theme; // ✅ Guardar el tema seleccionado o 'default' si es null o vacío

                var budget = existing.MonthlyBudgets
                    .FirstOrDefault(b => b.Year == DateTime.Now.Year && b.Month == DateTime.Now.Month);

                if (budget != null)
                {
                    budget.BudgetAmount = monthlyBudgetAmount;
                }
                else
                {
                    existing.MonthlyBudgets.Add(new MonthlyBudget
                        {
                            Year = DateTime.Now.Year,
                            Month = DateTime.Now.Month,
                            BudgetAmount = monthlyBudgetAmount
                        });
                }
            }
        }
        else
        {
            walletForm.CreatedDate = DateTime.Now;

            // 🔽 Obtener la posición siguiente (max + 1)
            var maxPosition = await DbContext.Wallets.MaxAsync(w => (int?)w.Position) ?? -1;
            walletForm.Position = maxPosition + 1;

            DbContext.Wallets.Add(walletForm);

            if (monthlyBudgetAmount > 0)
            {
                walletForm.MonthlyBudgets = new List<MonthlyBudget>
            {
                new MonthlyBudget
                {
                    Year = DateTime.Now.Year,
                    Month = DateTime.Now.Month,
                    BudgetAmount = monthlyBudgetAmount
                }
            };
            }
        }

        await DbContext.SaveChangesAsync();
        walletForm = new();
        monthlyBudgetAmount = 0;
        isEditing = false;
        showModal = false;
        await LoadWallets();
    }

    void SelectTheme(string theme)
    {
        walletForm.Theme = theme;
        StateHasChanged(); // Forzar render para que se vea seleccionado
    }

    void CancelEdit()
    {
        walletForm = new();
        isEditing = false;
        showModal = false;
    }

    void CloseModal()
    {
        CancelEdit();
    }

    async Task DeleteWallet(Budget1.Models.Wallet wallet)
    {
        // Verifica si hay transacciones asociadas al wallet
        bool hasTransactions = await DbContext.Transactions.AnyAsync(t => t.WalletId == wallet.Id);

        if (hasTransactions)
        {
            deleteErrorMessage = "Cannot delete the wallet because it has associated transactions.";
            return;
        }

        DbContext.Wallets.Remove(wallet);
        await DbContext.SaveChangesAsync();

        // Reordena las posiciones de los wallets restantes
        var walletsOrdered = await DbContext.Wallets
            .OrderBy(w => w.Position)
            .ToListAsync();

        for (int i = 0; i < walletsOrdered.Count; i++)
        {
            if (walletsOrdered[i].Position != i)
            {
                walletsOrdered[i].Position = i;
            }
        }

        await DbContext.SaveChangesAsync();

        deleteErrorMessage = null;
        await LoadWallets();
    }

    string GetCultureFromCurrency(string currency)
    {
        return currency switch
        {
            "USD" => "en-US",
            "EUR" => "fr-FR",
            "GBP" => "en-GB",
            "BOB" => "es-BO",
            "PEN" => "es-PE",
            "BRL" => "pt-BR",
            _ => "en-US"
        };
    }

    private async Task OnWalletOrderChanged(List<Wallet> newOrder)
    {
        for (int i = 0; i < newOrder.Count; i++)
        {
            var wallet = newOrder[i];
            var walletInDb = await DbContext.Wallets.FindAsync(wallet.Id);
            if (walletInDb != null)
            {
                walletInDb.Position = i;
            }
        }

        await DbContext.SaveChangesAsync();
        await LoadWallets(); // refresca la lista desde DB
    }

    private string FormatAmount(decimal amount, string currencyCode)
    {
        var culture = currencyCode switch
        {
            "USD" => new System.Globalization.CultureInfo("en-US"),
            "PEN" => new System.Globalization.CultureInfo("es-PE"),
            "EUR" => new System.Globalization.CultureInfo("fr-FR"),
            "BOB" => new System.Globalization.CultureInfo("es-BO"),
            "GBP" => new System.Globalization.CultureInfo("en-GB"),
            _ => System.Globalization.CultureInfo.InvariantCulture
        };

        return string.Format(culture, "{0:C}", amount);
    }

    // Antes (causaba el error)
    // private Dictionary<(Guid WalletId, DateTime MonthStart), decimal> cumulativeBalances = new();

    // Ahora (coincide con Wallet.Id = int)
    private Dictionary<(int WalletId, DateTime MonthStart), decimal> cumulativeBalances = new();


    decimal? CalculateAccumulatedBalance(Wallet w, List<Transaction> allTransactions)
    {
        if ((allTransactions == null || !allTransactions.Any()) && w.InitialBalance == 0)
            return null;

        decimal balance = 0m;
        var firstMonth = new DateTime(w.CreatedDate.Year, w.CreatedDate.Month, 1);
        var lastMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);

        for (var date = firstMonth; date <= lastMonth; date = date.AddMonths(1))
        {
            var monthTransactions = allTransactions
                .Where(t => t.WalletId == w.Id && t.Date.Year == date.Year && t.Date.Month == date.Month);

            decimal monthTotal = monthTransactions.Sum(t => t.IsIncome ? t.Amount : -t.Amount);

            if (date == firstMonth)
            {
                monthTotal += w.InitialBalance;
            }

            balance += monthTotal;
        }

        return balance;
    }


}

