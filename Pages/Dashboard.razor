@page "/dashboard"
@using Budget1.Models
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject Budget1.Data.BudgetDbContext DbContext
@using System.Globalization
@inject IJSRuntime JS


<h4 class="mb-3">Wallet</h4>

@if (wallets == null)
{
    <p><em>Loading...</em></p>
}
else if (!wallets.Any())
{
    <p><em>No wallets available yet.</em></p>
}
else
{

    <SortableList TItem="Wallet"
                  Data="wallets"
                  Context="w"
                  OnUpdate="@OnWalletListUpdate">
        <ItemTemplate>
            <div class="card wallet-card @($"wallet-theme-{w.Theme}")"
                 @onclick="() => ViewWallet(w.Id)">

                <div class="wallet-card-header">
                    <h3 class="card-title text-truncate" title="@w.Name">@w.Name</h3>
                    <i class="bi bi-wallet2 wallet-icon"></i>
                </div>

                <p class="card-text">
                    @{
                    var walletTransactions = allTransactions
                    .Where(t => t.WalletId == w.Id)
                    .ToList();

                    decimal? lastMonthBalance = CalculateAccumulatedBalance(w, walletTransactions);
                }

                @if (lastMonthBalance.HasValue)
                {
                    @FormatAmount(lastMonthBalance.Value, w.Currency)
                    <br />
                }
                else
                {
                    @FormatAmount(w.InitialBalance, w.Currency)
                    <br /> @* fallback *@
                }

                <span class="text-uppercase">@w.Currency</span>
            </p>

            <div class="btn-group w-100" role="group">
                <button class="btn btn-sm btn-outline-warning"
                        title="Edit"
                        @onclick="() => EditWallet(w)"
                @onclick:stopPropagation>
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger"
                        title="Delete"
                        @onclick="() => DeleteWallet(w)"
                @onclick:stopPropagation>
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>
    </ItemTemplate>
</SortableList>


}

<!-- BOTÓN FLOTANTE -->
<div id="floatingContainer" style="position: fixed; bottom: 20px; right: 20px; display: flex; align-items: center; cursor: grab;">

    <!-- Botón -->
    <button class="btn btn-success rounded-circle"
            style="width: 60px; height: 60px; font-size: 28px; box-shadow: 0 4px 8px rgba(0,0,0,0.3);"
            @onclick="ShowCreateModal">
        +
    </button>
    <!-- Área de arrastre -->
    <div id="dragHandle" style="width: 16px; height: 60px; background: rgba(0,0,0,0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 5px;">
        <div style="display: flex; flex-direction: column; gap: 3px;">
            <span style="width: 4px; height: 4px; background: #555; border-radius: 50%;"></span>
            <span style="width: 4px; height: 4px; background: #555; border-radius: 50%;"></span>
            <span style="width: 4px; height: 4px; background: #555; border-radius: 50%;"></span>
        </div>
    </div>

</div>

<!-- Modal -->
<div class="modal fade @(showModal ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,.5);" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <EditForm Model="walletForm" OnValidSubmit="SaveWallet">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="modal-header py-2">
                    <h6 class="modal-title mb-0">@((isEditing ? "Edit Wallet" : "New Wallet"))</h6>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body py-2">
                    <div class="mb-2">
                        <label class="form-label mb-1">Name</label>
                        <InputText class="form-control form-control-sm" @bind-Value="walletForm.Name" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label mb-1">Creation Date</label>
                        <InputDate class="form-control form-control-sm" @bind-Value="walletForm.CreatedDate" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label mb-1">Initial Balance</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="walletForm.InitialBalance" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label mb-1">Currency</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="walletForm.Currency">
                            @foreach (var c in currencyOptions)
                            {
                                    <option value="@c.Code">@c.Name (@c.Symbol)</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- 🎨 Selector de diseño -->
                    <div class="mb-2">
                        <label class="form-label mb-1">Wallet Design</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var theme in themes)
                            {
                                <div class="wallet-theme-option wallet-card @($"wallet-theme-{theme}") @(walletForm.Theme == theme ? "selected" : "")"
                                     @onclick="@(() => SelectTheme(theme))">
                                    @theme
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="modal-footer py-2">
                    <button type="submit" class="btn btn-primary btn-sm">@((isEditing ? "Update" : "Add"))</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseModal">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(deleteErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @deleteErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

