    protected override async Task OnParametersSetAsync()
    {
        if (SelectedWalletIdFromQuery.HasValue)
        {
            selectedWalletId = SelectedWalletIdFromQuery;
        }
        else
        {
            selectedWalletId = null;
        }

        await LoadData();

        if (!hasLoadedInitially)
        {
            if (selectedWallet != null) await LoadTransactions();
            hasLoadedInitially = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("addLongPressListeners", DotNetObjectReference.Create(this));
            await JS.InvokeVoidAsync("makeDraggableWithHandle", "floatingContainer", "dragHandle");
        }
    }

    private async Task LoadData()
    {
        wallets = await DbContext.Wallets.OrderByDescending(w => w.CreatedDate).ToListAsync();
        categories = await DbContext.Categories.ToListAsync();
        recurrenceIntervals = await DbContext.RecurrenceIntervals.OrderBy(i => i.Name).ToListAsync();
        holds = await DbContext.Holds.ToListAsync();


        if (selectedWalletId.HasValue)
        {
            selectedWallet = wallets.FirstOrDefault(w => w.Id == selectedWalletId.Value);
            if (selectedWallet == null)
            {
                groupedTransactions.Clear();
                cumulativeBalances.Clear();
                return;
            }
        }
        else
        {
            selectedWallet = null;
            groupedTransactions.Clear();
            cumulativeBalances.Clear();
            return;
        }

        var today = DateTime.Today;

        // Asegúrate de que selectedWallet.CreatedAt tiene una fecha válida
        if (selectedWallet != null && selectedWallet.CreatedDate != DateTime.MinValue)
        {
            startMonth ??= new DateTime(selectedWallet.CreatedDate.Year, selectedWallet.CreatedDate.Month, 1);
        }
        else
        {
            startMonth ??= new DateTime(today.Year, today.Month, 1);
        }

        endMonth ??= new DateTime(today.Year, today.Month, 1);


        if (selectedWallet != null) await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            var query = DbContext.Transactions
                .Include(t => t.Category)
                .Include(t => t.Wallet)
                .AsQueryable();

            if (selectedWalletId.HasValue)
                query = query.Where(t => t.WalletId == selectedWalletId.Value);

            DateTime globalStartDate = new DateTime(startMonth!.Value.Year, startMonth.Value.Month, 1);
            DateTime globalEndDate = new DateTime(endMonth!.Value.Year, endMonth.Value.Month, 1).AddMonths(1).AddDays(-1);

            query = query.Where(t => t.Date <= globalEndDate);

            var allTransactions = await query.OrderBy(t => t.Date).ToListAsync();

            groupedTransactions.Clear();
            cumulativeBalances.Clear();

            var walletMonthBalances = new Dictionary<(Wallet Wallet, DateTime Month), List<Transaction>>();
            decimal previousBalance = selectedWallet!.InitialBalance;

            for (var date = globalStartDate; date <= globalEndDate; date = date.AddMonths(1))
            {
                var monthStart = new DateTime(date.Year, date.Month, 1);
                var monthEnd = monthStart.AddMonths(1).AddDays(-1);

                var monthTxs = allTransactions
                    .Where(t => t.Date >= monthStart && t.Date <= monthEnd)
                    .ToList();

                var currentMonthBalance = monthTxs.Sum(t => t.IsIncome ? t.Amount : -t.Amount);
                previousBalance += currentMonthBalance;

                if (monthTxs.Any() || previousBalance != 0)
                {
                    walletMonthBalances[(selectedWallet, monthStart)] = monthTxs;
                    cumulativeBalances[(selectedWallet.Id, monthStart)] = previousBalance;
                }
            }

            groupedTransactions = walletMonthBalances;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnTransactionSaved()
    {
        CloseModalTransaction();
        _ = LoadTransactions();
    }


