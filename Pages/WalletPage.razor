    private void StartLongPress(int transactionId)
    {
        longPressTriggered = false;

        longPressTimer?.Stop();
        longPressTimer?.Dispose(); // evitar temporizadores pendientes
        longPressTimer = new System.Timers.Timer(500);
        longPressTimer.Elapsed += (s, e) =>
        {
            longPressTimer?.Stop();
            InvokeAsync(() =>
            {
                longPressTriggered = true;
                longPressTransactionId = transactionId;
                StateHasChanged();
            });
        };
        longPressTimer.AutoReset = false;
        longPressTimer.Start();
    }

    private void ToggleOverlayIfSame(int transactionId)
    {
        if (longPressTransactionId == transactionId)
        {
            CloseOverlay();
        }
    }

    [JSInvokable]
    public void OnOutsideClickOrEsc()
    {
        CloseOverlay();
    }

    private void CloseOverlay()
    {
        // detener cualquier long press activo
        longPressTimer?.Stop();
        longPressTimer?.Dispose();
        longPressTimer = null;

        longPressTransactionId = null;
        longPressTriggered = false;
        StateHasChanged();
    }

    private DateTime CalculateNextDate(DateTime currentDate, RecurrenceInterval interval)
    {
        // Si DaysInterval es mayor que cero, se usa directamente
        if (interval.DaysInterval > 0)
        {
            return currentDate.AddDays(interval.DaysInterval);
        }

        // Si DaysInterval es 0, se usa el Name para calcular el próximo
        return interval.Name switch
        {
            "Monthly" => currentDate.AddMonths(1),
            "Quarterly" => currentDate.AddMonths(3),
            "Semester" => currentDate.AddMonths(6),
            "Yearly" => currentDate.AddYears(1),
            _ => currentDate.AddDays(1) // Fallback por defecto si no hay coincidencia
        };
    }

    private string FormatAmount(decimal amount, string currencyCode)
    {
        var culture = currencyCode switch
        {
            "USD" => new System.Globalization.CultureInfo("en-US"),
            "PEN" => new System.Globalization.CultureInfo("es-PE"),
            "EUR" => new System.Globalization.CultureInfo("fr-FR"),
            "BOB" => new System.Globalization.CultureInfo("es-BO"),
            "GBP" => new System.Globalization.CultureInfo("en-GB"),
            _ => System.Globalization.CultureInfo.InvariantCulture
        };

        return string.Format(culture, "{0:C}", amount);
    }

    private async Task SaveHold(int walletId, DateTime month, decimal balance)
    {
        var hold = new Hold
            {
                WalletId = walletId,
                MonthHold = month,
                BalanceHold = balance
            };

        DbContext.Holds.Add(hold);
        await DbContext.SaveChangesAsync();

        message = "Hold";
        showSuccessModal = true;
        StateHasChanged(); // Asegura que se renderice el modal
        await LoadData();
    }

    private async Task DeleteHold(int holdId)
    {
        var hold = await DbContext.Holds.FindAsync(holdId);

        if (hold != null)
        {
            // Eliminar el hold
            DbContext.Holds.Remove(hold);

            // Actualizar en SQL directamente
            await DbContext.Transactions
                .Where(t => t.IsUnexpected == true &&
                            t.Date.Month == hold.MonthHold.Month &&
                            t.Date.Year == hold.MonthHold.Year)
                .ExecuteUpdateAsync(setters =>
                    setters.SetProperty(p => p.IsUnexpected, false)
                );

            await DbContext.SaveChangesAsync();

            // Mostrar modal y recargar
            message = "Hold";
            showSuccessModal = true;
            StateHasChanged();
            await LoadData();
        }
    }

    private async Task AddTithe(Transaction transaction, bool saveChanges)
    {
        var tithe = new Tithe
            {
                TransactionId = transaction.Id,
                Name = transaction.Name,
                Amount = transaction.Amount / 10,
                Date = transaction.Date,
                Payed = false, // o según corresponda
                // Transaction = transaction
            };

        DbContext.Tithes.Add(tithe);

        if (saveChanges)
        {
            await DbContext.SaveChangesAsync();
        }
        message = "Tithe";
        showSuccessModal = true;
    }

    public async Task DeleteTitheAsync(int titheId)
    {
        var tithe = await DbContext.Tithes.FindAsync(titheId);
        if (tithe != null)
        {
            DbContext.Tithes.Remove(tithe);
            await DbContext.SaveChangesAsync();
        }
    }


